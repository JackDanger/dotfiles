#!/bin/bash

# Minimal `timeout` for macOS (no GNU coreutils `timeout` on PATH by default).
#
# The previous version signaled only $$ (the single leader PID) after `exec "$@"` replaced
# this shell in place. That's correct for a leaf command, but if the command spawns its own
# children (e.g. a program that shells out to `git`), killing just the leader leaves those
# children running, orphaned -- confirmed live: an `aquaform` subprocess wrapped in
# `timeout 180 ...` left behind `git worktree add` children (and their worktrees) running
# well past the deadline because the parent alone was killed.
#
# Fix: run the command as its own process GROUP (via `set -m` job control) and signal the
# whole group (the negative pgid) so every child dies with it. SIGTERM first (the
# conventional graceful-shutdown signal, giving a well-behaved child a chance to clean up
# temp state), escalating to SIGKILL only if something's still alive after a grace period.

set -eo pipefail

GRACE_SECS=5
# Marker file: the watcher touches this iff it actually fired, so the exit code below can
# follow GNU timeout's own convention (124 = we killed it) instead of always passing through
# whatever raw signal-exit-status the killed process happened to get -- some scripts/CI steps
# key off exit 124 specifically to distinguish "timed out" from "ran and failed on its own".
fired_marker="$(mktemp -u)"

watch_and_kill() {
  local seconds=$1
  local pgid=$2
  local marker=$3
  sleep "$seconds"
  kill -0 -- "-$pgid" 2>/dev/null || return 0
  : >"$marker"
  kill -TERM -- "-$pgid" 2>/dev/null || return 0
  sleep "$GRACE_SECS"
  kill -0 -- "-$pgid" 2>/dev/null || return 0
  kill -KILL -- "-$pgid" 2>/dev/null || true
}

seconds=$1
shift

set -m
"$@" &
cmd_pid=$!
disown "$cmd_pid" 2>/dev/null || true
watch_and_kill "$seconds" "$cmd_pid" "$fired_marker" </dev/null >/dev/null 2>&1 &
watcher_pid=$!
disown "$watcher_pid" 2>/dev/null || true
set +e
wait "$cmd_pid"
status=$?
set -e
kill "$watcher_pid" 2>/dev/null || true
if [ -e "$fired_marker" ]; then
  rm -f "$fired_marker"
  exit 124
fi
exit "$status"

